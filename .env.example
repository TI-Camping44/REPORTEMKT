# =====================================================================
# REPORTEMKT — Variables de entorno
# =====================================================================
#
# Copie este archivo a .env.local y complete los valores. .env.local esta en
# .gitignore y no se versiona nunca.
#
# En Vercel, las mismas variables se cargan en Project Settings → Environment
# Variables, para los tres entornos (Production, Preview, Development).
# ---------------------------------------------------------------------

# Direccion del proyecto de Supabase.
# Supabase → Project Settings → API Keys, o el panel del proyecto.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave publicable (antes llamada anon). Viaja al navegador: no es secreta.
# Sirve porque todas las tablas tienen RLS activo y politicas escritas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Clave secreta (antes llamada service_role). IGNORA las politicas RLS.
# Nunca lleva el prefijo NEXT_PUBLIC_ y nunca atiende una peticion de la
# interfaz: solo scripts de mantenimiento. Si se filtra, rotela en el panel
# de Supabase.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Dominio de Google Workspace autorizado a ingresar, sin arroba.
# No se escribe en el codigo. Tiene que coincidir con la fila
# `dominio_permitido` de la tabla `configuracion`, que es la que lee el
# disparador de la base.
DOMINIO_PERMITIDO=empresa.com.py

# Base publica de la aplicacion. Se usa para armar la direccion de retorno de
# la autenticacion con Google.
#   Desarrollo: http://localhost:3000
#   Produccion: https://reportemkt.vercel.app (o el dominio propio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
